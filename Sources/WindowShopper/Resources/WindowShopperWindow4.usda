        float inputs:in1.connect = </WindowShopperWindow4/GlassStrength.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/GlassUncovered.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedRoom" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow4/PrivacyComposite.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow4.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "WindowGlassComposite" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow4/GlassTintedRoom.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow4/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow4/UncoveredGlassMix.outputs:out>
        color3f outputs:out
    }
    def Shader "WindowFinalColor" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow4/WindowGlassComposite.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow4/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow4.inputs:ReflectionOnly>
        color3f outputs:out
    }
    def Shader "AuthoredEmissionSurface" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindow4/HeadlampSurface.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow4/NormalViewEmission.outputs:out>
        color3f outputs:out
    }

    # BEGIN SHARED CITY AIR
    def Shader "AirWorld" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirEye" {
        uniform token info:id = "ND_realitykit_cameraposition_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirLocal" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "object"
        float3 outputs:out
    }
    def Shader "AirEyeLocal" {
        uniform token info:id = "ND_transformpoint_vector3"
        float3 inputs:in.connect = </WindowShopperWindow4/AirEye.outputs:out>
        string inputs:fromspace = "world"
        string inputs:tospace = "object"
        float3 outputs:out
    }
    def Shader "AirHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow4/AirLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow4.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirEyeHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow4/AirEyeLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow4.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirEyeHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirEyeHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirRay" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow4/AirWorld.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow4/AirEye.outputs:out>
        float3 outputs:out
    }
    def Shader "AirDistance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow4/AirRay.outputs:out>
        float outputs:out
    }
    def Shader "AirHeightDelta" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirEyeHeight.outputs:out>
        float outputs:out
    }
    def Shader "AirStep0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.125
        float outputs:out
    }
    def Shader "AirSample0" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirStep0.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow0" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow4/AirSample0.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp0" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirBelow0.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight0" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow4/AirRamp0.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirWeight0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirWeight0.outputs:out>
        float outputs:out
    }
    def Shader "AirStep1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.375
        float outputs:out
    }
    def Shader "AirSample1" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirStep1.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow1" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow4/AirSample1.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp1" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirBelow1.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight1" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow4/AirRamp1.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirWeight1.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirWeight1.outputs:out>
        float outputs:out
    }
    def Shader "AirStep2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.625
        float outputs:out
    }
    def Shader "AirSample2" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirStep2.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow2" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow4/AirSample2.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp2" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirBelow2.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight2" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow4/AirRamp2.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirWeight2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirWeight2.outputs:out>
        float outputs:out
    }
    def Shader "AirStep3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.875
        float outputs:out
    }
    def Shader "AirSample3" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirStep3.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow3" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow4/AirSample3.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp3" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirBelow3.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight3" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow4/AirRamp3.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirWeight3.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirWeight3.outputs:out>
        float outputs:out
    }
    def Shader "AirPairA" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirDensity0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirDensity1.outputs:out>
        float outputs:out
    }
    def Shader "AirPairB" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirDensity2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirDensity3.outputs:out>
        float outputs:out
    }
    def Shader "AirLowerSum" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirPairA.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirPairB.outputs:out>
        float outputs:out
    }
    def Shader "AirLower" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirLowerSum.outputs:out>
        float inputs:in2 = 0.0625
        float outputs:out
    }
    def Shader "AirBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4.inputs:FogDensity>
        float inputs:in2 = -0.32
        float outputs:out
    }
    def Shader "AirDensity" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirBase.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirLower.outputs:out>
        float outputs:out
    }
    def Shader "AirDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4/AirDensity.outputs:out>
        float outputs:out
    }
    def Shader "AirEnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow4.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "AirNegativeDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow4/AirEnabledDepth.outputs:out>
        float inputs:in2 = -1
        float outputs:out
    }
    def Shader "AirTransmission" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow4/AirNegativeDepth.outputs:out>
        float outputs:out
    }
    def Shader "AirColour" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.014, 0.055, 0.105)
        float inputs:in2.connect = </WindowShopperWindow4.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "AirUnified" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow4/AirColour.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow4/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow4/AirTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "AirOutput" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow4/Blend.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow4/AirUnified.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow4.inputs:CityAirEnabled>
        color3f outputs:out
    }
    # END SHARED CITY AIR
}
