    }
    def Shader "Position" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "Camera" {
        uniform token info:id = "ND_realitykit_cameraposition_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "Offset" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/Position.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0Sofa/Camera.outputs:out>
        float3 outputs:out
    }
    def Shader "Distance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow0Sofa/Offset.outputs:out>
        float outputs:out
    }
    def Shader "ClearZone" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/Distance.outputs:out>
        float inputs:in2 = 0
        float outputs:out
    }
    def Shader "PositiveDistance" {
        uniform token info:id = "ND_max_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/ClearZone.outputs:out>
        float inputs:in2 = 0
        float outputs:out
    }
    def Shader "HeavierFog" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AltitudeDensity.outputs:out>
        float inputs:in2 = 2
