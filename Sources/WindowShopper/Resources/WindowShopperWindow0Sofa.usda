        color3f inputs:in2.connect = </WindowShopperWindow0Sofa/GlassEnvironmentMinus.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassEnvironmentSum" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/GlassEnvironment.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0Sofa/GlassBlurSum.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassEnvironmentAverage" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/GlassEnvironmentSum.outputs:out>
        float inputs:in2 = 0.3333333333333333
        color3f outputs:out
    }
    def Shader "GlassExposedEnvironment" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/GlassEnvironmentAverage.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:ReflectionExposure>
        color3f outputs:out
    }
    def Shader "GlassAbsDot" {
        uniform token info:id = "ND_absval_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/GlassDot.outputs:out>
        float outputs:out
    }
    def Shader "GlassClampDot" {
        uniform token info:id = "ND_min_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/GlassAbsDot.outputs:out>
        float inputs:in2 = 1
        float outputs:out
    }
    def Shader "GlassGrazing" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0Sofa/GlassClampDot.outputs:out>
        float outputs:out
    }
    def Shader "GlassFresnel" {
        uniform token info:id = "ND_power_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/GlassGrazing.outputs:out>
        float inputs:in2 = 5
        float outputs:out
    }
    def Shader "GlassFresnelScale" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/GlassFresnel.outputs:out>
        float inputs:in2 = 0.8
        float outputs:out
    }
    def Shader "GlassFresnelFloor" {
        uniform token info:id = "ND_add_float"
        float inputs:in1 = 0.2
        float inputs:in2.connect = </WindowShopperWindow0Sofa/GlassFresnelScale.outputs:out>
        float outputs:out
    }
    def Shader "GlassStrength" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa.inputs:ReflectionStrength>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/GlassFresnelFloor.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedEmission" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/PrivacyEmission.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "GlassTransmission" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0Sofa/GlassStrength.outputs:out>
        float outputs:out
    }
    def Shader "GlassTransmittedEmission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/GlassTintedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/GlassTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "NormalView" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:ReflectionOnly>
        float outputs:out
    }
    def Shader "NormalViewEmission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/GlassTransmittedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/NormalView.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassUncovered" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0Sofa/PrivacyMask.outputs:out>
        float outputs:out
    }
    def Shader "UncoveredGlassMix" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/GlassStrength.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/GlassUncovered.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedRoom" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/PrivacyComposite.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "WindowGlassComposite" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0Sofa/GlassTintedRoom.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0Sofa/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0Sofa/UncoveredGlassMix.outputs:out>
        color3f outputs:out
    }
    def Shader "WindowFinalColor" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0Sofa/WindowGlassComposite.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0Sofa/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0Sofa.inputs:ReflectionOnly>
        color3f outputs:out
    }
    def Shader "AuthoredEmissionSurface" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampSurface.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0Sofa/NormalViewEmission.outputs:out>
        color3f outputs:out
    }

    # BEGIN SHARED CITY AIR
    def Shader "AirWorld" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirEye" {
        uniform token info:id = "ND_realitykit_cameraposition_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirLocal" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "object"
        float3 outputs:out
    }
    def Shader "AirEyeLocal" {
        uniform token info:id = "ND_transformpoint_vector3"
        float3 inputs:in.connect = </WindowShopperWindow0Sofa/AirEye.outputs:out>
        string inputs:fromspace = "world"
        string inputs:tospace = "object"
        float3 outputs:out
    }
    def Shader "AirHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/AirLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirEyeHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/AirEyeLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirEyeHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirEyeHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirRay" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/AirWorld.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0Sofa/AirEye.outputs:out>
        float3 outputs:out
    }
    def Shader "AirDistance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow0Sofa/AirRay.outputs:out>
        float outputs:out
    }
    def Shader "AirHeightDelta" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirEyeHeight.outputs:out>
        float outputs:out
    }
    def Shader "AirStep0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.125
        float outputs:out
    }
    def Shader "AirSample0" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirStep0.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow0" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirSample0.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp0" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirBelow0.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight0" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/AirRamp0.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirWeight0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirWeight0.outputs:out>
        float outputs:out
    }
    def Shader "AirStep1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.375
        float outputs:out
    }
    def Shader "AirSample1" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirStep1.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow1" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirSample1.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp1" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirBelow1.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight1" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/AirRamp1.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirWeight1.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirWeight1.outputs:out>
        float outputs:out
    }
    def Shader "AirStep2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.625
        float outputs:out
    }
    def Shader "AirSample2" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirStep2.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow2" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirSample2.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp2" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirBelow2.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight2" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/AirRamp2.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirWeight2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirWeight2.outputs:out>
        float outputs:out
    }
    def Shader "AirStep3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.875
        float outputs:out
    }
    def Shader "AirSample3" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirStep3.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow3" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirSample3.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp3" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirBelow3.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight3" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/AirRamp3.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirWeight3.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirWeight3.outputs:out>
        float outputs:out
    }
    def Shader "AirPairA" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirDensity0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirDensity1.outputs:out>
        float outputs:out
    }
    def Shader "AirPairB" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirDensity2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirDensity3.outputs:out>
        float outputs:out
    }
    def Shader "AirLowerSum" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirPairA.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirPairB.outputs:out>
        float outputs:out
    }
    def Shader "AirLower" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirLowerSum.outputs:out>
        float inputs:in2 = 0.0625
        float outputs:out
    }
    def Shader "AirBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa.inputs:FogDensity>
        float inputs:in2 = -0.32
        float outputs:out
    }
    def Shader "AirDensity" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirBase.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirLower.outputs:out>
        float outputs:out
    }
    def Shader "AirDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/AirDensity.outputs:out>
        float outputs:out
    }
    def Shader "AirEnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "AirNegativeDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/AirEnabledDepth.outputs:out>
        float inputs:in2 = -1
        float outputs:out
    }
    def Shader "AirTransmission" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/AirNegativeDepth.outputs:out>
        float outputs:out
    }
    def Shader "AirColour" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.014, 0.055, 0.105)
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "AirUnified" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0Sofa/AirColour.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0Sofa/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0Sofa/AirTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "AirOutput" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0Sofa/Blend.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0Sofa/AirUnified.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0Sofa.inputs:CityAirEnabled>
        color3f outputs:out
    }
    # END SHARED CITY AIR
}
