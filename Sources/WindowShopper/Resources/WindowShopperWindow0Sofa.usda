    }
    def Shader "OpticalDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/PositiveDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/HeavierFog.outputs:out>
        float outputs:out
    }
    def Shader "EnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/OpticalDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "Transmittance" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/EnabledDepth.outputs:out>
        float outputs:out
    }
    def Shader "FogColor" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.0024, 0.0045, 0.007)
        float inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "Blend" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0Sofa/FogColor.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0Sofa/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0Sofa/Transmittance.outputs:out>
        color3f outputs:out
    }
    def Shader "HeadlampOffset" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/Position.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:HeadlightOrigin>
        float3 outputs:out
    }
    def Shader "HeadlampDistance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow0Sofa/HeadlampOffset.outputs:out>
        float outputs:out
    }
    def Shader "HeadlampSafeDistance" {
        uniform token info:id = "ND_max_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampDistance.outputs:out>
        float inputs:in2 = 0.05
        float outputs:out
    }
    def Shader "HeadlampDirection" {
        uniform token info:id = "ND_divide_vector3FA"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampOffset.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/HeadlampSafeDistance.outputs:out>
        float3 outputs:out
    }
    def Shader "HeadlampAngle" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampDirection.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0Sofa.inputs:HeadlightForward>
        float outputs:out
    }
    def Shader "HeadlampCone" {
        uniform token info:id = "ND_smoothstep_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/HeadlampAngle.outputs:out>
        float inputs:low = 0.88
        float inputs:high = 0.97
        float outputs:out
    }
    def Shader "HeadlampFar" {
        uniform token info:id = "ND_smoothstep_float"
        float inputs:in.connect = </WindowShopperWindow0Sofa/HeadlampDistance.outputs:out>
        float inputs:low = 6
        float inputs:high = 14
        float outputs:out
    }
    def Shader "HeadlampFade" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0Sofa/HeadlampFar.outputs:out>
        float outputs:out
    }
    def Shader "HeadlampSquared" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0Sofa/HeadlampDistance.outputs:out>
        float outputs:out
    }
    def Shader "HeadlampFalloff" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampSquared.outputs:out>
        float inputs:in2 = 0.055
        float outputs:out
    }
    def Shader "HeadlampDenominator" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0Sofa/HeadlampFalloff.outputs:out>
        float inputs:in2 = 1
        float outputs:out
    }
    def Shader "HeadlampPower" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1 = 42
        float inputs:in2.connect = </WindowShopperWindow0Sofa/HeadlampDenominator.outputs:out>
        float outputs:out
    }
    def Shader "HeadlampNormal" {
        uniform token info:id = "ND_normal_vector3"
        string inputs:space = "world"
        float3 outputs:out
