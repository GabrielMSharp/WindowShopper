    def Shader "GlassFresnel" {
        uniform token info:id = "ND_power_float"
        float inputs:in1.connect = </WindowShopperWindow0/GlassGrazing.outputs:out>
        float inputs:in2 = 5
        float outputs:out
    }
    def Shader "GlassFresnelScale" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/GlassFresnel.outputs:out>
        float inputs:in2 = 0.8
        float outputs:out
    }
    def Shader "GlassFresnelFloor" {
        uniform token info:id = "ND_add_float"
        float inputs:in1 = 0.2
        float inputs:in2.connect = </WindowShopperWindow0/GlassFresnelScale.outputs:out>
        float outputs:out
    }
    def Shader "GlassStrength" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0.inputs:ReflectionStrength>
        float inputs:in2.connect = </WindowShopperWindow0/GlassFresnelFloor.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedEmission" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0/PrivacyEmission.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "GlassTransmission" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0/GlassStrength.outputs:out>
        float outputs:out
    }
    def Shader "GlassTransmittedEmission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow0/GlassTintedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/GlassTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "NormalView" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0.inputs:ReflectionOnly>
        float outputs:out
    }
    def Shader "NormalViewEmission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow0/GlassTransmittedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/NormalView.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassUncovered" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow0/PrivacyMask.outputs:out>
        float outputs:out
    }
    def Shader "UncoveredGlassMix" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/GlassStrength.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/GlassUncovered.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedRoom" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0/PrivacyComposite.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "WindowGlassComposite" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0/GlassTintedRoom.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0/UncoveredGlassMix.outputs:out>
        color3f outputs:out
    }
    def Shader "WindowFinalColor" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0/WindowGlassComposite.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0.inputs:ReflectionOnly>
        color3f outputs:out
    }
    def Shader "AuthoredEmissionSurface" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindow0/HeadlampSurface.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow0/NormalViewEmission.outputs:out>
        color3f outputs:out
    }

    # BEGIN SHARED CITY AIR
    def Shader "AirWorld" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirEye" {
        uniform token info:id = "ND_realitykit_cameraposition_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirLocal" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "object"
        float3 outputs:out
    }
    def Shader "AirEyeLocal" {
        uniform token info:id = "ND_transformpoint_vector3"
        float3 inputs:in.connect = </WindowShopperWindow0/AirEye.outputs:out>
        string inputs:fromspace = "world"
        string inputs:tospace = "object"
        float3 outputs:out
    }
    def Shader "AirHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0/AirLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirEyeHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0/AirEyeLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirEyeHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirEyeHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirRay" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow0/AirWorld.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow0/AirEye.outputs:out>
        float3 outputs:out
    }
    def Shader "AirDistance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow0/AirRay.outputs:out>
        float outputs:out
    }
    def Shader "AirHeightDelta" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirEyeHeight.outputs:out>
        float outputs:out
    }
    def Shader "AirStep0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.125
        float outputs:out
    }
    def Shader "AirSample0" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirStep0.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow0" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0/AirSample0.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp0" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirBelow0.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight0" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0/AirRamp0.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirWeight0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirWeight0.outputs:out>
        float outputs:out
    }
    def Shader "AirStep1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.375
        float outputs:out
    }
    def Shader "AirSample1" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirStep1.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow1" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0/AirSample1.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp1" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirBelow1.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight1" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0/AirRamp1.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirWeight1.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirWeight1.outputs:out>
        float outputs:out
    }
    def Shader "AirStep2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.625
        float outputs:out
    }
    def Shader "AirSample2" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirStep2.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow2" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0/AirSample2.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp2" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirBelow2.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight2" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0/AirRamp2.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirWeight2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirWeight2.outputs:out>
        float outputs:out
    }
    def Shader "AirStep3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.875
        float outputs:out
    }
    def Shader "AirSample3" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirStep3.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow3" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow0/AirSample3.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp3" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirBelow3.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight3" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow0/AirRamp3.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirWeight3.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirWeight3.outputs:out>
        float outputs:out
    }
    def Shader "AirPairA" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirDensity0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirDensity1.outputs:out>
        float outputs:out
    }
    def Shader "AirPairB" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirDensity2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirDensity3.outputs:out>
        float outputs:out
    }
    def Shader "AirLowerSum" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirPairA.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirPairB.outputs:out>
        float outputs:out
    }
    def Shader "AirLower" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirLowerSum.outputs:out>
        float inputs:in2 = 0.0625
        float outputs:out
    }
    def Shader "AirBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0.inputs:FogDensity>
        float inputs:in2 = -0.32
        float outputs:out
    }
    def Shader "AirDensity" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirBase.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirLower.outputs:out>
        float outputs:out
    }
    def Shader "AirDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0/AirDensity.outputs:out>
        float outputs:out
    }
    def Shader "AirEnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow0.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "AirNegativeDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow0/AirEnabledDepth.outputs:out>
        float inputs:in2 = -1
        float outputs:out
    }
    def Shader "AirTransmission" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow0/AirNegativeDepth.outputs:out>
        float outputs:out
    }
    def Shader "AirColour" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.014, 0.055, 0.105)
        float inputs:in2.connect = </WindowShopperWindow0.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "AirUnified" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0/AirColour.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0/AirTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "AirOutput" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow0/Blend.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow0/AirUnified.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow0.inputs:CityAirEnabled>
        color3f outputs:out
    }
    # END SHARED CITY AIR
}
