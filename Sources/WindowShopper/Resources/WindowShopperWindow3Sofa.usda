        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.625
        float outputs:out
    }
    def Shader "AirSample2" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirStep2.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow2" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirSample2.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp2" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirBelow2.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight2" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/AirRamp2.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirWeight2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirWeight2.outputs:out>
        float outputs:out
    }
    def Shader "AirStep3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.875
        float outputs:out
    }
    def Shader "AirSample3" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirStep3.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow3" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirSample3.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp3" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirBelow3.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight3" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/AirRamp3.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirWeight3.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirWeight3.outputs:out>
        float outputs:out
    }
    def Shader "AirPairA" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirDensity0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirDensity1.outputs:out>
        float outputs:out
    }
    def Shader "AirPairB" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirDensity2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirDensity3.outputs:out>
        float outputs:out
    }
    def Shader "AirLowerSum" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirPairA.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirPairB.outputs:out>
        float outputs:out
    }
    def Shader "AirLower" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirLowerSum.outputs:out>
        float inputs:in2 = 0.0625
        float outputs:out
    }
    def Shader "AirBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa.inputs:FogDensity>
        float inputs:in2 = -0.32
        float outputs:out
    }
    def Shader "AirDensity" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirBase.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirLower.outputs:out>
        float outputs:out
    }
    def Shader "AirDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/AirDensity.outputs:out>
        float outputs:out
    }
    def Shader "AirEnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "AirNegativeDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AirEnabledDepth.outputs:out>
        float inputs:in2 = -1
        float outputs:out
    }
    def Shader "AirTransmission" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/AirNegativeDepth.outputs:out>
        float outputs:out
    }
    def Shader "AirColour" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.014, 0.055, 0.105)
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "AirUnified" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow3Sofa/AirColour.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow3Sofa/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow3Sofa/AirTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "AirOutput" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow3Sofa/Blend.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow3Sofa/AirUnified.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow3Sofa.inputs:CityAirEnabled>
        color3f outputs:out
    }
    # END SHARED CITY AIR
}
