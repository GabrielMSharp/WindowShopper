#usda 1.0
def Material "WindowShopperWindow3Sofa" {
    float2 inputs:RoomSize = (3.2, 2.8)
    float inputs:RoomDepth = 2.5
    float2 inputs:SurfaceTileSize = (3, 3)
    float inputs:SurfaceRepeat = 0
    asset inputs:ShellTexture
    asset inputs:SurfaceTexture
    float4 inputs:BackRect = (0, 0, 1, 1)
    float4 inputs:LeftRect = (0, 0, 1, 1)
    float4 inputs:RightRect = (0, 0, 1, 1)
    float4 inputs:FloorRect = (0, 0, 1, 1)
    float4 inputs:CeilingRect = (0, 0, 1, 1)
    asset inputs:RoomEmissionTexture
    float inputs:RoomEmissionGain = 0
    float3 inputs:SofaSize = (1.6, 0.9, 0.75)
    float inputs:SofaFront = 0.8
    float inputs:SofaX = 0
    color3f inputs:SofaTint = (0.65, 0.3, 0.09)
    asset inputs:Layer0Texture
    float inputs:Layer0Depth = 0.5
    float2 inputs:Layer0Size = (3.2, 2.8)
    float2 inputs:Layer0Offset = (0, 0)
    float inputs:Layer0Opacity = 1
    color3f inputs:Layer0Tint = (1, 1, 1)
    float4 inputs:Layer0Rect = (0, 0, 1, 1)
    asset inputs:Layer0EmissionTexture
    float inputs:Layer0EmissionGain = 0
    asset inputs:Layer1Texture
    float inputs:Layer1Depth = 0.5
    float2 inputs:Layer1Size = (3.2, 2.8)
    float2 inputs:Layer1Offset = (0, 0)
    float inputs:Layer1Opacity = 1
    color3f inputs:Layer1Tint = (1, 1, 1)
    float4 inputs:Layer1Rect = (0, 0, 1, 1)
    asset inputs:Layer1EmissionTexture
    float inputs:Layer1EmissionGain = 0
    asset inputs:Layer2Texture
    float inputs:Layer2Depth = 0.5
    float2 inputs:Layer2Size = (3.2, 2.8)
    float2 inputs:Layer2Offset = (0, 0)
    float inputs:Layer2Opacity = 1
    color3f inputs:Layer2Tint = (1, 1, 1)
    float4 inputs:Layer2Rect = (0, 0, 1, 1)
    asset inputs:Layer2EmissionTexture
    float inputs:Layer2EmissionGain = 0
    float2 inputs:ApertureSize = (3.2, 2.8)
    float2 inputs:ApertureOffset = (0, 0)
    float inputs:ShutterCoverage = 0
    float inputs:Mullion = 0
    float inputs:Crossbar = 0
    asset inputs:ReflectionTexture
    float inputs:ReflectionStrength = 0.25
    color3f inputs:GlassTint = (1, 1, 1)
    float inputs:ReflectionRotation = 0
    float inputs:ReflectionExposure = 1
    float inputs:ReflectionBlur = 0
    float inputs:ReflectionOnly = 0
    asset inputs:Facade
    asset inputs:OcclusionMap
    color3f inputs:Tint = (1, 1, 1)
    float2 inputs:SurfaceUVScale = (1, 1)
    float2 inputs:SurfaceUVOffset = (0, 0)
    float inputs:PackedAtlasUV = 0
    float inputs:StructuralAmbientShape = 0
    float inputs:DistrictAmbientGain = 1
    float inputs:DistrictHighlightGain = 1
    float inputs:AltitudeHazeScale = 1
    float inputs:FogDensity = -0.0185
    float inputs:FogBrightness = 0.8
    float inputs:FogEnabled = 1
    float inputs:EmissionStrength = 0
    float inputs:EmissionThreshold = 0.12
    color3f inputs:EmissionTint = (1, 1, 1)
    float3 inputs:HeadlightOrigin = (0, 1.04, -1.37)
    float3 inputs:HeadlightForward = (0, -0.10443, -0.99453)
    float inputs:HeadlightEnabled = 0
    # BEGIN SHARED CITY AIR PARAMETERS
    float inputs:CityAirEnabled = 0
    float3 inputs:CityHeightAxis = (0, 1, 0)
    float inputs:CityHeightOffset = 0
    # END SHARED CITY AIR PARAMETERS
    token outputs:mtlx:surface.connect = </WindowShopperWindow3Sofa/Surface.outputs:out>
    def Shader "UV" {
        uniform token info:id = "ND_texcoord_vector2"
        int inputs:index = 0
        float2 outputs:out
    }
    # A face carries one tile identifier in UV.x's 256-wide band. Physical
    # repeats remain continuous vertex UVs; only this fragment stage wraps them.
    def Shader "PackedU" {
        uniform token info:id = "ND_extract_vector2"
        float2 inputs:in.connect = </WindowShopperWindow3Sofa/UV.outputs:out>
        int inputs:index = 0
        float outputs:out
    }
    def Shader "PackedV" {
        uniform token info:id = "ND_extract_vector2"
        float2 inputs:in.connect = </WindowShopperWindow3Sofa/UV.outputs:out>
        int inputs:index = 1
        float outputs:out
    }
    def Shader "TileBand" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/PackedU.outputs:out>
        float inputs:in2 = 256
        float outputs:out
    }
    def Shader "TileID" {
        uniform token info:id = "ND_floor_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/TileBand.outputs:out>
        float outputs:out
    }
    def Shader "EncodedBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/TileID.outputs:out>
        float inputs:in2 = 256
        float outputs:out
    }
    def Shader "LocalU" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/PackedU.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/EncodedBase.outputs:out>
        float outputs:out
    }
    def Shader "LocalUV" {
        uniform token info:id = "ND_combine2_vector2"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/LocalU.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/PackedV.outputs:out>
        float2 outputs:out
    }
    def Shader "TileRowBand" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/TileID.outputs:out>
        float inputs:in2 = 4
        float outputs:out
    }
    def Shader "TileRow" {
        uniform token info:id = "ND_floor_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/TileRowBand.outputs:out>
        float outputs:out
    }
    def Shader "TileRowStart" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/TileRow.outputs:out>
        float inputs:in2 = 4
        float outputs:out
    }
    def Shader "TileColumn" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/TileID.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/TileRowStart.outputs:out>
        float outputs:out
    }
    def Shader "TileCell" {
        uniform token info:id = "ND_combine2_vector2"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/TileColumn.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/TileRow.outputs:out>
        float2 outputs:out
    }
    # Square 2048px atlas: 4x4 cells, each 512px with a 3px gutter.
    # IDs 0...5 retain their cells; IDs 6/7 add upper mineral wall/floor skins.
    # Keep these normalized constants aligned with WindowShopperWindow3Sofa.swift.
    def Shader "TileOrigin" {
        uniform token info:id = "ND_multiply_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/TileCell.outputs:out>
        float2 inputs:in2 = (0.25, 0.25)
        float2 outputs:out
    }
    def Shader "ScaledUV" {
        uniform token info:id = "ND_multiply_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/LocalUV.outputs:out>
        float2 inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:SurfaceUVScale>
        float2 outputs:out
    }
    def Shader "TransformedLocalUV" {
        uniform token info:id = "ND_add_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/ScaledUV.outputs:out>
        float2 inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:SurfaceUVOffset>
        float2 outputs:out
    }
    def Shader "LocalCell" {
        uniform token info:id = "ND_floor_vector2"
        float2 inputs:in.connect = </WindowShopperWindow3Sofa/TransformedLocalUV.outputs:out>
        float2 outputs:out
    }
    def Shader "WrappedLocalUV" {
        uniform token info:id = "ND_subtract_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/TransformedLocalUV.outputs:out>
        float2 inputs:in2.connect = </WindowShopperWindow3Sofa/LocalCell.outputs:out>
        float2 outputs:out
    }
    def Shader "InteriorUV" {
        uniform token info:id = "ND_multiply_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/WrappedLocalUV.outputs:out>
        float2 inputs:in2 = (0.2470703125, 0.2470703125)
        float2 outputs:out
    }
    def Shader "InsetUV" {
        uniform token info:id = "ND_add_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/InteriorUV.outputs:out>
        float2 inputs:in2 = (0.00146484375, 0.00146484375)
        float2 outputs:out
    }
    def Shader "SurfaceUV" {
        uniform token info:id = "ND_add_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/InsetUV.outputs:out>
        float2 inputs:in2.connect = </WindowShopperWindow3Sofa/TileOrigin.outputs:out>
        float2 outputs:out
    }
    # Authored district art uses ordinary atlas UVs, while structural skins
    # retain the compact tile encoding. This is one shared opaque shader path.
    def Shader "AuthoredScaledUV" {
        uniform token info:id = "ND_multiply_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/UV.outputs:out>
        float2 inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:SurfaceUVScale>
        float2 outputs:out
    }
    def Shader "AuthoredUV" {
        uniform token info:id = "ND_add_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/AuthoredScaledUV.outputs:out>
        float2 inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:SurfaceUVOffset>
        float2 outputs:out
    }
    def Shader "SelectedUV" {
        uniform token info:id = "ND_mix_vector2"
        float2 inputs:bg.connect = </WindowShopperWindow3Sofa/AuthoredUV.outputs:out>
        float2 inputs:fg.connect = </WindowShopperWindow3Sofa/SurfaceUV.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow3Sofa.inputs:PackedAtlasUV>
        float2 outputs:out
    }
    def Shader "SelectedContinuousUV" {
        uniform token info:id = "ND_mix_vector2"
        float2 inputs:bg.connect = </WindowShopperWindow3Sofa/AuthoredUV.outputs:out>
        float2 inputs:fg.connect = </WindowShopperWindow3Sofa/ContinuousInteriorUV.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow3Sofa.inputs:PackedAtlasUV>
        float2 outputs:out
    }
    # Derivatives come from continuous coordinates, before wrapping. Implicit
    # derivatives of fract would pick coarse mips at every repeat seam.
    # Public RealityKitTexture2DGradient / MTL_dfdx nodes are defined by the SDK.
    def Shader "ContinuousInteriorUV" {
        uniform token info:id = "ND_multiply_vector2"
        float2 inputs:in1.connect = </WindowShopperWindow3Sofa/TransformedLocalUV.outputs:out>
        float2 inputs:in2 = (0.2470703125, 0.2470703125)
        float2 outputs:out
    }
    def Shader "UVGradientX" {
        uniform token info:id = "ND_MTL_dfdx_vector2"
        float2 inputs:p.connect = </WindowShopperWindow3Sofa/SelectedContinuousUV.outputs:out>
        float2 outputs:out
    }
    def Shader "UVGradientY" {
        uniform token info:id = "ND_MTL_dfdy_vector2"
        float2 inputs:p.connect = </WindowShopperWindow3Sofa/SelectedContinuousUV.outputs:out>
        float2 outputs:out
    }
    def Shader "Image" {
        uniform token info:id = "ND_RealityKitTexture2DGradient_color3"
        bool inputs:no_flip_v = true
        asset inputs:file.connect = </WindowShopperWindow3Sofa.inputs:Facade>
        float2 inputs:texcoord.connect = </WindowShopperWindow3Sofa/SelectedUV.outputs:out>
        float2 inputs:gradient_dPdx.connect = </WindowShopperWindow3Sofa/UVGradientX.outputs:out>
        float2 inputs:gradient_dPdy.connect = </WindowShopperWindow3Sofa/UVGradientY.outputs:out>
        color3f outputs:out
    }
    def Shader "Tint" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/WindowFinalColor.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:Tint>
        color3f outputs:out
    }
    def Shader "ThresholdColor" {
        uniform token info:id = "ND_convert_float_color3"
        float inputs:in.connect = </WindowShopperWindow3Sofa.inputs:EmissionThreshold>
        color3f outputs:out
    }
    def Shader "BrightTexels" {
        uniform token info:id = "ND_subtract_color3"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/WindowFinalColor.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow3Sofa/ThresholdColor.outputs:out>
        color3f outputs:out
    }
    def Shader "EmissionMask" {
        uniform token info:id = "ND_max_color3"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/BrightTexels.outputs:out>
        color3f inputs:in2 = (0, 0, 0)
        color3f outputs:out
    }
    def Shader "TintedEmission" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/EmissionMask.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:EmissionTint>
        color3f outputs:out
    }
    def Shader "Emission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/TintedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:EmissionStrength>
        color3f outputs:out
    }
    def Shader "LitSurface" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/OccludedTint.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindow3Sofa/Emission.outputs:out>
        color3f outputs:out
    }
    # Generated/baked source pictures were authored at full image brightness.
    # Dim their ambient surfaces in linear space; only genuinely bright baked
    # practical pixels retain more energy. This never adds light or boosts a
    # source above its authored value. Headlight reception is added afterwards.
    def Shader "SourceRGB" {
        uniform token info:id = "ND_convert_color3_vector3"
        color3f inputs:in.connect = </WindowShopperWindow3Sofa/WindowFinalColor.outputs:out>
        float3 outputs:out
    }
    def Shader "SourceLuminance" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow3Sofa/SourceRGB.outputs:out>
        float3 inputs:in2 = (0.2126, 0.7152, 0.0722)
        float outputs:out
    }
    def Shader "PracticalMask" {
        uniform token info:id = "ND_smoothstep_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/SourceLuminance.outputs:out>
        float inputs:low = 0.60
        float inputs:high = 0.92
        float outputs:out
    }
    def Shader "DistrictGain" {
        uniform token info:id = "ND_mix_float"
        float inputs:bg.connect = </WindowShopperWindow3Sofa.inputs:DistrictAmbientGain>
        float inputs:fg.connect = </WindowShopperWindow3Sofa.inputs:DistrictHighlightGain>
        float inputs:mix.connect = </WindowShopperWindow3Sofa/PracticalMask.outputs:out>
        float outputs:out
    }
    # Modest static ambient shape for unbaked structural tiles only. Object
    # normal is stable as the city moves; authored interiors retain their bake.
    def Shader "StructureNormal" {
        uniform token info:id = "ND_normal_vector3"
        string inputs:space = "object"
        float3 outputs:out
    }
    def Shader "StructureUp" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow3Sofa/StructureNormal.outputs:out>
        float3 inputs:in2 = (0, 1, 0)
        float outputs:out
    }
    def Shader "StructureTilt" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/StructureUp.outputs:out>
        float inputs:in2 = 0.20
        float outputs:out
    }
    def Shader "StructureValue" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/StructureTilt.outputs:out>
        float inputs:in2 = 0.80
        float outputs:out
    }
    def Shader "StructureEnabled" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa.inputs:StructuralAmbientShape>
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:PackedAtlasUV>
        float outputs:out
    }
    def Shader "StructureShape" {
        uniform token info:id = "ND_mix_float"
        float inputs:bg = 1
        float inputs:fg.connect = </WindowShopperWindow3Sofa/StructureValue.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow3Sofa/StructureEnabled.outputs:out>
        float outputs:out
    }
    def Shader "ShapedDistrictGain" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/DistrictGain.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/StructureShape.outputs:out>
        float outputs:out
    }
    def Shader "DistrictNightSurface" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/LitSurface.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/ShapedDistrictGain.outputs:out>
        color3f outputs:out
    }
    def Shader "OcclusionTexture" {
        uniform token info:id = "ND_RealityKitTexture2DGradient_vector4"
        bool inputs:no_flip_v = true
        asset inputs:file.connect = </WindowShopperWindow3Sofa.inputs:OcclusionMap>
        float4 inputs:default = (1, 0, 0, 1)
        float2 inputs:texcoord.connect = </WindowShopperWindow3Sofa/SelectedUV.outputs:out>
        float2 inputs:gradient_dPdx.connect = </WindowShopperWindow3Sofa/UVGradientX.outputs:out>
        float2 inputs:gradient_dPdy.connect = </WindowShopperWindow3Sofa/UVGradientY.outputs:out>
        float4 outputs:out
    }
    def Shader "BakedAO" {
        uniform token info:id = "ND_extract_vector4"
        float4 inputs:in.connect = </WindowShopperWindow3Sofa/OcclusionTexture.outputs:out>
        int inputs:index = 3
        float outputs:out
    }
    def Shader "OccludedTint" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindow3Sofa/Tint.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/BakedAO.outputs:out>
        color3f outputs:out
    }
    def Shader "AltitudeDensity" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa.inputs:FogDensity>
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:AltitudeHazeScale>
        float outputs:out
    }
    def Shader "Position" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "Camera" {
        uniform token info:id = "ND_realitykit_cameraposition_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "Offset" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow3Sofa/Position.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow3Sofa/Camera.outputs:out>
        float3 outputs:out
    }
    def Shader "Distance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow3Sofa/Offset.outputs:out>
        float outputs:out
    }
    def Shader "ClearZone" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/Distance.outputs:out>
        float inputs:in2 = 0
        float outputs:out
    }
    def Shader "PositiveDistance" {
        uniform token info:id = "ND_max_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/ClearZone.outputs:out>
        float inputs:in2 = 0
        float outputs:out
    }
    def Shader "HeavierFog" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/AltitudeDensity.outputs:out>
        float inputs:in2 = 2
        float outputs:out
    }
    def Shader "OpticalDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/PositiveDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/HeavierFog.outputs:out>
        float outputs:out
    }
    def Shader "EnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/OpticalDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "Transmittance" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/EnabledDepth.outputs:out>
        float outputs:out
    }
    def Shader "FogColor" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.0024, 0.0045, 0.007)
        float inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "Blend" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow3Sofa/FogColor.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow3Sofa/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow3Sofa/Transmittance.outputs:out>
        color3f outputs:out
    }
    def Shader "HeadlampOffset" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow3Sofa/Position.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:HeadlightOrigin>
        float3 outputs:out
    }
    def Shader "HeadlampDistance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindow3Sofa/HeadlampOffset.outputs:out>
        float outputs:out
    }
    def Shader "HeadlampSafeDistance" {
        uniform token info:id = "ND_max_float"
        float inputs:in1.connect = </WindowShopperWindow3Sofa/HeadlampDistance.outputs:out>
        float inputs:in2 = 0.05
        float outputs:out
    }
    def Shader "HeadlampDirection" {
        uniform token info:id = "ND_divide_vector3FA"
        float3 inputs:in1.connect = </WindowShopperWindow3Sofa/HeadlampOffset.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow3Sofa/HeadlampSafeDistance.outputs:out>
        float3 outputs:out
    }
    def Shader "HeadlampAngle" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindow3Sofa/HeadlampDirection.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindow3Sofa.inputs:HeadlightForward>
        float outputs:out
    }
    def Shader "HeadlampCone" {
        uniform token info:id = "ND_smoothstep_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/HeadlampAngle.outputs:out>
        float inputs:low = 0.88
        float inputs:high = 0.97
        float outputs:out
    }
    def Shader "HeadlampFar" {
        uniform token info:id = "ND_smoothstep_float"
        float inputs:in.connect = </WindowShopperWindow3Sofa/HeadlampDistance.outputs:out>
        float inputs:low = 6
        float inputs:high = 14
        float outputs:out
    }
    def Shader "HeadlampFade" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindow3Sofa/HeadlampFar.outputs:out>
        float outputs:out
