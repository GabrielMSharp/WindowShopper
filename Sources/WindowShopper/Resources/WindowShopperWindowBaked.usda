        int inputs:index = 1
        float outputs:out
    }
    def Shader "GlassBlurVZeroMinus" {
        uniform token info:id = "ND_max_float"
        float inputs:in1 = 0
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassBlurVMinus.outputs:out>
        float outputs:out
    }
    def Shader "GlassBlurVClampMinus" {
        uniform token info:id = "ND_min_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassBlurVZeroMinus.outputs:out>
        float outputs:out
    }
    def Shader "GlassBlurWrappedMinus" {
        uniform token info:id = "ND_combine2_vector2"
        float inputs:in1.connect = </WindowShopperWindowBaked/GlassBlurFractMinus.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassBlurVClampMinus.outputs:out>
        float2 outputs:out
    }
    def Shader "GlassEnvironmentMinus" {
        uniform token info:id = "ND_RealityKitTexture2D_color3"
        asset inputs:file.connect = </WindowShopperWindowBaked.inputs:ReflectionTexture>
        float2 inputs:texcoord.connect = </WindowShopperWindowBaked/GlassBlurWrappedMinus.outputs:out>
        bool inputs:no_flip_v = true
        color3f outputs:out
    }
    def Shader "GlassBlurSum" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/GlassEnvironmentPlus.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindowBaked/GlassEnvironmentMinus.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassEnvironmentSum" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/GlassEnvironment.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindowBaked/GlassBlurSum.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassEnvironmentAverage" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/GlassEnvironmentSum.outputs:out>
        float inputs:in2 = 0.3333333333333333
        color3f outputs:out
    }
    def Shader "GlassExposedEnvironment" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/GlassEnvironmentAverage.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked.inputs:ReflectionExposure>
        color3f outputs:out
    }
    def Shader "GlassAbsDot" {
        uniform token info:id = "ND_absval_float"
        float inputs:in.connect = </WindowShopperWindowBaked/GlassDot.outputs:out>
        float outputs:out
    }
    def Shader "GlassClampDot" {
        uniform token info:id = "ND_min_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/GlassAbsDot.outputs:out>
        float inputs:in2 = 1
        float outputs:out
    }
    def Shader "GlassGrazing" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassClampDot.outputs:out>
        float outputs:out
    }
    def Shader "GlassFresnel" {
        uniform token info:id = "ND_power_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/GlassGrazing.outputs:out>
        float inputs:in2 = 5
        float outputs:out
    }
    def Shader "GlassFresnelScale" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/GlassFresnel.outputs:out>
        float inputs:in2 = 0.8
        float outputs:out
    }
    def Shader "GlassFresnelFloor" {
        uniform token info:id = "ND_add_float"
        float inputs:in1 = 0.2
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassFresnelScale.outputs:out>
        float outputs:out
    }
    def Shader "GlassStrength" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked.inputs:ReflectionStrength>
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassFresnelFloor.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedEmission" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/PrivacyEmission.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindowBaked.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "GlassTransmission" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassStrength.outputs:out>
        float outputs:out
    }
    def Shader "GlassTransmittedEmission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/GlassTintedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "NormalView" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindowBaked.inputs:ReflectionOnly>
        float outputs:out
    }
    def Shader "NormalViewEmission" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/GlassTransmittedEmission.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/NormalView.outputs:out>
        color3f outputs:out
    }
    def Shader "GlassUncovered" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 1
        float inputs:in2.connect = </WindowShopperWindowBaked/PrivacyMask.outputs:out>
        float outputs:out
    }
    def Shader "UncoveredGlassMix" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/GlassStrength.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/GlassUncovered.outputs:out>
        float outputs:out
    }
    def Shader "GlassTintedRoom" {
        uniform token info:id = "ND_multiply_color3"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/PrivacyComposite.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindowBaked.inputs:GlassTint>
        color3f outputs:out
    }
    def Shader "WindowGlassComposite" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindowBaked/GlassTintedRoom.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindowBaked/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindowBaked/UncoveredGlassMix.outputs:out>
        color3f outputs:out
    }
    def Shader "WindowFinalColor" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindowBaked/WindowGlassComposite.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindowBaked/GlassExposedEnvironment.outputs:out>
        float inputs:mix.connect = </WindowShopperWindowBaked.inputs:ReflectionOnly>
        color3f outputs:out
    }
    def Shader "AuthoredEmissionSurface" {
        uniform token info:id = "ND_add_color3"
        color3f inputs:in1.connect = </WindowShopperWindowBaked/HeadlampSurface.outputs:out>
        color3f inputs:in2.connect = </WindowShopperWindowBaked/NormalViewEmission.outputs:out>
        color3f outputs:out
    }

    # BEGIN SHARED CITY AIR
    def Shader "AirWorld" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirEye" {
        uniform token info:id = "ND_realitykit_cameraposition_vector3"
        string inputs:space = "world"
        float3 outputs:out
    }
    def Shader "AirLocal" {
        uniform token info:id = "ND_position_vector3"
        string inputs:space = "object"
        float3 outputs:out
    }
    def Shader "AirEyeLocal" {
        uniform token info:id = "ND_transformpoint_vector3"
        float3 inputs:in.connect = </WindowShopperWindowBaked/AirEye.outputs:out>
        string inputs:fromspace = "world"
        string inputs:tospace = "object"
        float3 outputs:out
    }
    def Shader "AirHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindowBaked/AirLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindowBaked.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirEyeHeightDot" {
        uniform token info:id = "ND_dotproduct_vector3"
        float3 inputs:in1.connect = </WindowShopperWindowBaked/AirEyeLocal.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindowBaked.inputs:CityHeightAxis>
        float outputs:out
    }
    def Shader "AirEyeHeight" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirEyeHeightDot.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked.inputs:CityHeightOffset>
        float outputs:out
    }
    def Shader "AirRay" {
        uniform token info:id = "ND_subtract_vector3"
        float3 inputs:in1.connect = </WindowShopperWindowBaked/AirWorld.outputs:out>
        float3 inputs:in2.connect = </WindowShopperWindowBaked/AirEye.outputs:out>
        float3 outputs:out
    }
    def Shader "AirDistance" {
        uniform token info:id = "ND_magnitude_vector3"
        float3 inputs:in.connect = </WindowShopperWindowBaked/AirRay.outputs:out>
        float outputs:out
    }
    def Shader "AirHeightDelta" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirEyeHeight.outputs:out>
        float outputs:out
    }
    def Shader "AirStep0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.125
        float outputs:out
    }
    def Shader "AirSample0" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirStep0.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow0" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindowBaked/AirSample0.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp0" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirBelow0.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight0" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindowBaked/AirRamp0.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity0" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirWeight0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirWeight0.outputs:out>
        float outputs:out
    }
    def Shader "AirStep1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.375
        float outputs:out
    }
    def Shader "AirSample1" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirStep1.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow1" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindowBaked/AirSample1.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp1" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirBelow1.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight1" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindowBaked/AirRamp1.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity1" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirWeight1.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirWeight1.outputs:out>
        float outputs:out
    }
    def Shader "AirStep2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.625
        float outputs:out
    }
    def Shader "AirSample2" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirStep2.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow2" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindowBaked/AirSample2.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp2" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirBelow2.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight2" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindowBaked/AirRamp2.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity2" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirWeight2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirWeight2.outputs:out>
        float outputs:out
    }
    def Shader "AirStep3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirHeightDelta.outputs:out>
        float inputs:in2 = 0.875
        float outputs:out
    }
    def Shader "AirSample3" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirEyeHeight.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirStep3.outputs:out>
        float outputs:out
    }
    def Shader "AirBelow3" {
        uniform token info:id = "ND_subtract_float"
        float inputs:in1 = 15
        float inputs:in2.connect = </WindowShopperWindowBaked/AirSample3.outputs:out>
        float outputs:out
    }
    def Shader "AirRamp3" {
        uniform token info:id = "ND_divide_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirBelow3.outputs:out>
        float inputs:in2 = 35
        float outputs:out
    }
    def Shader "AirWeight3" {
        uniform token info:id = "ND_clamp_float"
        float inputs:in.connect = </WindowShopperWindowBaked/AirRamp3.outputs:out>
        float inputs:low = 0
        float inputs:high = 1
        float outputs:out
    }
    def Shader "AirDensity3" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirWeight3.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirWeight3.outputs:out>
        float outputs:out
    }
    def Shader "AirPairA" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirDensity0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirDensity1.outputs:out>
        float outputs:out
    }
    def Shader "AirPairB" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirDensity2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirDensity3.outputs:out>
        float outputs:out
    }
    def Shader "AirLowerSum" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirPairA.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirPairB.outputs:out>
        float outputs:out
    }
    def Shader "AirLower" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirLowerSum.outputs:out>
        float inputs:in2 = 0.0625
        float outputs:out
    }
    def Shader "AirBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked.inputs:FogDensity>
        float inputs:in2 = -0.32
        float outputs:out
    }
    def Shader "AirDensity" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirBase.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirLower.outputs:out>
        float outputs:out
    }
    def Shader "AirDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked/AirDensity.outputs:out>
        float outputs:out
    }
    def Shader "AirEnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindowBaked.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "AirNegativeDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindowBaked/AirEnabledDepth.outputs:out>
        float inputs:in2 = -1
        float outputs:out
    }
    def Shader "AirTransmission" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindowBaked/AirNegativeDepth.outputs:out>
        float outputs:out
    }
    def Shader "AirColour" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.014, 0.055, 0.105)
        float inputs:in2.connect = </WindowShopperWindowBaked.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "AirUnified" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindowBaked/AirColour.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindowBaked/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindowBaked/AirTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "AirOutput" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindowBaked/Blend.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindowBaked/AirUnified.outputs:out>
        float inputs:mix.connect = </WindowShopperWindowBaked.inputs:CityAirEnabled>
        color3f outputs:out
    }
    # END SHARED CITY AIR
}
