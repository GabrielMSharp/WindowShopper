        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirWeight3.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1/AirWeight3.outputs:out>
        float outputs:out
    }
    def Shader "AirPairA" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirDensity0.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1/AirDensity1.outputs:out>
        float outputs:out
    }
    def Shader "AirPairB" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirDensity2.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1/AirDensity3.outputs:out>
        float outputs:out
    }
    def Shader "AirLowerSum" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirPairA.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1/AirPairB.outputs:out>
        float outputs:out
    }
    def Shader "AirLower" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirLowerSum.outputs:out>
        float inputs:in2 = 0.0625
        float outputs:out
    }
    def Shader "AirBase" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow1.inputs:FogDensity>
        float inputs:in2 = -0.32
        float outputs:out
    }
    def Shader "AirDensity" {
        uniform token info:id = "ND_add_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirBase.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1/AirLower.outputs:out>
        float outputs:out
    }
    def Shader "AirDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirDistance.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1/AirDensity.outputs:out>
        float outputs:out
    }
    def Shader "AirEnabledDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirDepth.outputs:out>
        float inputs:in2.connect = </WindowShopperWindow1.inputs:FogEnabled>
        float outputs:out
    }
    def Shader "AirNegativeDepth" {
        uniform token info:id = "ND_multiply_float"
        float inputs:in1.connect = </WindowShopperWindow1/AirEnabledDepth.outputs:out>
        float inputs:in2 = -1
        float outputs:out
    }
    def Shader "AirTransmission" {
        uniform token info:id = "ND_exp_float"
        float inputs:in.connect = </WindowShopperWindow1/AirNegativeDepth.outputs:out>
        float outputs:out
    }
    def Shader "AirColour" {
        uniform token info:id = "ND_multiply_color3FA"
        color3f inputs:in1 = (0.014, 0.055, 0.105)
        float inputs:in2.connect = </WindowShopperWindow1.inputs:FogBrightness>
        color3f outputs:out
    }
    def Shader "AirUnified" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow1/AirColour.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow1/AuthoredEmissionSurface.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow1/AirTransmission.outputs:out>
        color3f outputs:out
    }
    def Shader "AirOutput" {
        uniform token info:id = "ND_mix_color3"
        color3f inputs:bg.connect = </WindowShopperWindow1/Blend.outputs:out>
        color3f inputs:fg.connect = </WindowShopperWindow1/AirUnified.outputs:out>
        float inputs:mix.connect = </WindowShopperWindow1.inputs:CityAirEnabled>
        color3f outputs:out
    }
    # END SHARED CITY AIR
}
